# Public application URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase backend access. Prefer a modern sb_secret_ key; never prefix it NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# PortOne V2 / Eximbay new-module channel
PORTONE_STORE_ID=store-your-store-id
PORTONE_EXIMBAY_CHANNEL_KEY=channel-key-your-eximbay-channel
PORTONE_API_SECRET=your-portone-api-secret
PORTONE_WEBHOOK_SECRET=your-portone-webhook-secret
